PORT=9999
# 0.0.0.0 = reachable from a phone / emulator on the same network (localhost would only accept this computer)
HOST=0.0.0.0
MONGO_URI=mongodb://127.0.0.1:27017/cookflow_db
# Required: use a long random string (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development
# Comma-separated list of allowed origins for browsers. Use * to allow all.
# Mobile apps and Postman do not send an Origin header, so they are always allowed.
CORS_ORIGIN=http://localhost:8081,http://localhost:19006
# Email codes (verification / password reset): no mail server is configured, so the code is printed
# in the server console and, outside production, returned as "devCode" in the API response.
# Set to false to stop returning it in responses.
OTP_EXPOSE_IN_RESPONSE=true
